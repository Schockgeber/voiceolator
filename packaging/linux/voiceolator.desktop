[Desktop Entry]
Type=Application
Name=Voiceolator
GenericName=Streamer voice isolation
Comment=Hear only the streamer's voice: removes music, game sounds and alerts in real time
Exec=voiceolator %F
Icon=voiceolator
Terminal=false
Categories=AudioVideo;Audio;
Keywords=twitch;stream;voice;speech;noise;music;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-flv;video/mp2t;audio/mpeg;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/flac;audio/ogg;audio/opus;
StartupWMClass=Voiceolator
